@model CleanValveManagement.Models.PermitDetailsViewModel

@{
    ViewData["Title"] = "Permit Details";
}

<div class="details-wrapper">
    <div class="details-header">
        <div>
            <h2>Permit Details</h2>
            <p>Permit No: @Model.PermitNumber</p>
        </div>

        <a asp-controller="Permit"
           asp-action="@ViewBag.BackAction"
           class="back-btn">
            ← Back
        </a>
    </div>

    <div class="info-card">
        <div>
            <span>Permit Type</span>
            <strong>@Model.PermitType</strong>
        </div>

        <div>
            <span>Requestor</span>
            <strong>@Model.RequestorName</strong>
        </div>
    </div>

    <h3 class="section-title">Site Photos</h3>

    <div class="photo-grid">
        @foreach (var img in Model.Images)
        {
            <div class="photo-card">
                <h4>@img.Title</h4>

                @if (!string.IsNullOrWhiteSpace(img.ImagePath))
                {
                    <img src="@img.ImagePath"
                         alt="@img.Title"
                         onclick="openImage('@img.ImagePath')"
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                    <div class="no-image">Image not available</div>
                }
                else
                {
                    <div class="no-image" style="display:flex;">Image not available</div>
                }

                <div class="no-image">Image not available</div>
            </div>
        }
    </div>
</div>

<div id="imageModal" class="image-modal">
    <span class="close-btn" onclick="closeImage()">×</span>
    <img id="previewImage" src="" />
</div>

<style>
    .details-wrapper {
        max-width: 1300px;
        margin: 30px auto;
        padding: 20px;
        font-family: 'Segoe UI', Arial, sans-serif;
    }

    .details-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
    }

        .details-header h2 {
            color: #0a3d78;
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .details-header p {
            color: #6b7280;
            margin: 0;
        }

    .back-btn {
        background: #0a4d94;
        color: white;
        text-decoration: none;
        padding: 10px 18px;
        border-radius: 9px;
        font-weight: 600;
    }

    .info-card {
        background: white;
        border-radius: 14px;
        padding: 20px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.08);
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        border-left: 5px solid #0a4d94;
        margin-bottom: 26px;
    }

        .info-card span {
            display: block;
            color: #6b7280;
            font-size: 13px;
            margin-bottom: 5px;
        }

        .info-card strong {
            color: #1f2937;
            font-size: 16px;
        }

    .section-title {
        color: #0a3d78;
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 18px;
    }

    .photo-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .photo-card {
        background: white;
        border-radius: 14px;
        padding: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.08);
    }

        .photo-card h4 {
            color: #0a3d78;
            font-size: 15px;
            margin-bottom: 12px;
        }

        .photo-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 10px;
            cursor: pointer;
            border: 1px solid #e5e7eb;
        }

    .no-image {
        display: none;
        height: 180px;
        border-radius: 10px;
        background: #f1f5f9;
        color: #64748b;
        align-items: center;
        justify-content: center;
        font-weight: 600;
    }

    .image-modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.75);
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

        .image-modal img {
            max-width: 85%;
            max-height: 85%;
            border-radius: 12px;
            background: white;
        }

    .close-btn {
        position: absolute;
        top: 25px;
        right: 35px;
        color: white;
        font-size: 38px;
        cursor: pointer;
    }
</style>

<script>
    let zoomLevel = 1;

    function openImage(path) {
        const modal = document.getElementById("imageModal");
        const img = document.getElementById("previewImage");

        zoomLevel = 1;
        img.style.transform = "scale(1)";
        img.src = path;

        modal.style.display = "flex";
        document.body.classList.add("modal-open");
    }

    function closeImage() {
        document.getElementById("imageModal").style.display = "none";
        document.body.classList.remove("modal-open");
    }

    document.addEventListener("DOMContentLoaded", function () {
        const img = document.getElementById("previewImage");

        img.addEventListener("wheel", function (e) {
            e.preventDefault();
            e.stopPropagation();

            zoomLevel += e.deltaY < 0 ? 0.1 : -0.1;
            zoomLevel = Math.min(Math.max(zoomLevel, 1), 3);

            img.style.transform = "scale(" + zoomLevel + ")";
        });
    });
</script>