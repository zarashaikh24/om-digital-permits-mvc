@model List<CleanValveManagement.Models.CPPermitReport>

@{
    ViewData["Title"] = "Cathodic Protection Dashboard";
}

@{
    string userType = Context.Session.GetString("UserType") ?? "";
    bool hasBothAccess = userType.Contains("CP") && userType.Contains("CNG");
}

<div class="dashboard-wrapper">

    <div class="dashboard-header">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; width:100%;">
            <div>
                <h2>Cathodic Protection Permits</h2>
                <p>View and track permit requests assigned for approval and monitoring.</p>
            </div>
        </div>
    </div>

    @if (hasBothAccess)
    {
        <div class="module-tabs">
            <a asp-controller="Permit" asp-action="CathodicProtection" class="tab-link active">
                Cathodic Protection
            </a>

            <a asp-controller="Permit" asp-action="CNG" class="tab-link">
                CNG Permits
            </a>
        </div>
    }

    <form asp-controller="Permit" asp-action="CathodicProtection" method="get" class="filter-card">
        <div class="filter-title">Filters</div>

        <div class="filter-row">
            <select name="status">
                <option value="">All Status</option>
                <option value="Requested" selected="@(Context.Request.Query["status"] == "Requested" ? "selected" : null)">Requested</option>
                <option value="APPROVED" selected="@(Context.Request.Query["status"] == "APPROVED" ? "selected" : null)">Approved</option>
                <option value="Rejected" selected="@(Context.Request.Query["status"] == "REJECTED" ? "selected" : null)">Rejected</option>
                <option value="Closed" selected="@(Context.Request.Query["status"] == "Closed" ? "selected" : null)">Closed</option>
            </select>

            <input type="date" name="fromDate" value="@Context.Request.Query["fromDate"]" />

            <input type="date" name="toDate" value="@Context.Request.Query["toDate"]" />

            <input type="text"
                   name="permitNumber"
                   placeholder="Search Permit Number"
                   value="@Context.Request.Query["permitNumber"]" />

            <button type="submit" class="apply-btn">Apply</button>

            <a asp-controller="Permit" asp-action="CathodicProtection" class="clear-btn">
                Clear Filter
            </a>
        </div>
    </form>

    <div class="record-count">
        Total Records: <strong>@(Model == null ? 0 : Model.Count)</strong> |
        Showing:
        <span style="font-weight:700; color:#003b78;">
            @(Model == null ? 0 : (Model.Count > 100 ? 100 : Model.Count))
        </span>
    </div>

    <div class="table-card">

        @if (ViewBag.NoData != null)
        {
            <div class="alert alert-warning" style="margin-bottom:15px;">
                @ViewBag.NoData
            </div>
        }

        <table class="report-table">
            <thead>
                <tr>
                    <th>View</th>
                    <th>Permit Number</th>
                    <th>Permit Type</th>
                    <th>Requestor</th>
                    <th>Approver</th>
                    <th>PO Number</th>
                    <th>STC Number</th>
                    <th>Raised On</th>
                    <th>Current Status</th>
                    <th>Remarks</th>
                    <th>Approved On</th>
                    <th>Closed On</th>
                </tr>
            </thead>

            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="12" style="text-align:center; padding:30px; font-weight:600; color:#555;">
                            No permits have been raised by this user.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Permit"
                                   asp-action="Details"
                                   asp-route-id="@item.id"
                                   class="view-btn">
                                    Details
                                </a>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.PermitType) &&
                                                        item.PermitType.ToLower().Contains("electrical"))
                                {
                                    <a asp-controller="Permit"
                                       asp-action="CPElectricalPermitPrint"
                                       asp-route-id="@item.id"
                                       target="_blank"
                                       style="color:#0d6efd; font-weight:600; text-decoration:none;">
                                        @item.id
                                    </a>
                                }
                                else if (!string.IsNullOrEmpty(item.PermitType) &&
                                item.PermitType.ToLower().Contains("confined"))
                                {
                                    <a asp-controller="Permit"
                                       asp-action="CSEPermitPrint"
                                       asp-route-id="@item.id"
                                       target="_blank"
                                       style="color:#0d6efd; font-weight:600; text-decoration:none;">
                                        @item.id
                                    </a>
                                }
                                else if (!string.IsNullOrEmpty(item.PermitType) &&
                                item.PermitType.ToLower().Contains("hot"))
                                {
                                    <a asp-controller="Permit"
                                       asp-action="CPHotColdWorkPermitPrint"
                                       asp-route-id="@item.id"
                                       target="_blank"
                                       style="color:#0d6efd; font-weight:600; text-decoration:none;">
                                        @item.id
                                    </a>
                                }
                                else
                                {
                                    @item.id
                                }
                            </td>

                            <td>@item.PermitType</td>
                            <td>@item.AIC_name</td>
                            <td>@(string.IsNullOrEmpty(item.TPE_name) ? "-" : item.TPE_name)</td>
                            <td>@item.PONo</td>
                            <td>@item.STCNo</td>
                            <td>@item.created_at</td>
                            <td>@item.status</td>
                            <td>@(string.IsNullOrEmpty(item.review_msg) ? "-" : item.review_msg)</td>
                            <td>@(string.IsNullOrEmpty(item.approved_at) ? "-" : item.approved_at)</td>
                            <td>@(string.IsNullOrEmpty(item.closed_at) ? "-" : item.closed_at)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <div class="pagination-container">
            <div class="pagination-buttons">
                <button type="button" class="page-btn" id="prevBtn">← Previous</button>
                <button type="button" class="page-btn" id="nextBtn">Next →</button>
            </div>

            <div class="page-info" id="pageInfo">
                Page 1 out of 1
            </div>
        </div>

       
    </div>
</div>

<div id="pageLoader" class="page-loader"></div>


<style>
    body {
        background: #f4f7fb;
        font-family: 'Segoe UI', Arial, sans-serif;
    }

    .dashboard-wrapper {
        max-width: 1400px;
        margin: 30px auto;
        padding: 20px;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

        .dashboard-header h2 {
            color: #0a3d78;
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .dashboard-header p {
            color: #6b7280;
            font-size: 15px;
        }

    .summary-card {
        background: #ffffff;
        padding: 18px 28px;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.08);
        text-align: center;
        border-left: 5px solid #0a4d94;
    }

        .summary-card span {
            display: block;
            color: #6b7280;
            font-size: 13px;
            margin-bottom: 4px;
        }

        .summary-card strong {
            color: #0a3d78;
            font-size: 28px;
        }

    .filter-card {
        background: #ffffff;
        padding: 20px;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.07);
        margin-bottom: 24px;
        border-left: 5px solid #0a4d94;
    }

    .filter-title {
        color: #0a3d78;
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 16px;
    }

    .filter-row {
        display: grid;
        grid-template-columns: 170px 170px 170px 1fr 100px;
        gap: 16px;
    }

        .filter-row input,
        .filter-row select {
            padding: 12px 14px;
            border: 1px solid #d6dbe3;
            border-radius: 8px;
            font-size: 14px;
            outline: none;
            min-width: 180px;
        }

            .filter-row input:focus,
            .filter-row select:focus {
                border-color: #0a4d94;
                box-shadow: 0 0 0 3px rgba(10,77,148,0.08);
            }

        .filter-row button {
            background: #0a4d94;
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
        }

            .filter-row button:hover {
                background: #073a70;
            }

    .table-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.08);
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1100px;
    }

    thead {
        background: #0a3d78;
        color: white;
    }

    th {
        padding: 15px 14px;
        text-align: left;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    td {
        padding: 14px;
        border-bottom: 1px solid #e5e7eb;
        font-size: 14px;
        color: #1f2937;
        white-space: nowrap;
    }

    tbody tr:hover {
        background: #f8fbff;
    }

    .view-btn {
        background: #e8f1fb;
        color: #0a4d94;
        padding: 7px 12px;
        border-radius: 7px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }

        .view-btn:hover {
            background: #d6e8fa;
        }

    .status {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .requested {
        background: #fff7ed;
        color: #c2410c;
    }

    .closed {
        background: #dcfce7;
        color: #166534;
    }

    @@media (max-width: 768px) {
        .dashboard-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .filter-bar {
            flex-direction: column;
        }
    }

    .module-tabs {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
}

.tab-link {
    padding: 12px 22px;
    background: white;
    border: 1px solid #d6dbe3;
    border-radius: 10px;
    text-decoration: none;
    color: #0a3d78;
    font-weight: 600;
    transition: 0.3s;
}

.tab-link:hover {
    background: #e8f1fb;
}

.tab-link.active {
    background: #0a4d94;
    color: white;
    border-color: #0a4d94;
}
.logout-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.45);
    justify-content: center;
    align-items: center;
    z-index: 9999;
}

.logout-modal-content {
    background: white;
    width: 420px;
    border-radius: 16px;
    padding: 26px;
    text-align: center;
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.22);
}

.logout-modal-content h3 {
    color: #0a3d78;
    font-size: 22px;
    margin-bottom: 10px;
}

.logout-modal-content p {
    color: #4b5563;
    font-size: 15px;
    margin-bottom: 24px;
}

.logout-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
}

.cancel-btn {
    background: #eef2f7;
    color: #334155;
    border: none;
    padding: 10px 22px;
    border-radius: 9px;
    font-weight: 600;
    cursor: pointer;
}

.confirm-btn {
    background: #dc2626;
    color: white;
    border: none;
    padding: 10px 22px;
    border-radius: 9px;
    font-weight: 600;
    cursor: pointer;
}
    .pagination-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        padding: 25px;
    }

    .pagination-buttons {
        display: flex;
        gap: 20px;
    }

    .page-btn {
        border: 1px solid #d6dbe3;
        background: white;
        color: #0a3d78;
        padding: 8px 12px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
    }

        .page-btn.active {
            background: #0a4d94;
            color: white;
            border-color: #0a4d94;
        }

#pageInfo {

    font-size: 16px;

    font-weight: 600;

    color: #0a3d78;

    text-align: center;
}
.filter-row{
    display:grid;
    grid-template-columns:170px 170px 170px 1fr 100px 120px;
    gap:14px;
    align-items:center;
}

.apply-btn{
    background:#0a4d94;
    color:white;
    border:none;
    border-radius:8px;
    height:46px;
    font-weight:600;
}

.clear-btn{
    background:#0a4d94;
    color:white !important;

    text-decoration:none;

    height:46px;
    border-radius:8px;

    display:flex;
    align-items:center;
    justify-content:center;

    font-weight:600;
}

.apply-btn:hover,
.clear-btn:hover{
    background:#073a70;
}
