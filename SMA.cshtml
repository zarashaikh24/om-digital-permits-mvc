@model List<CleanValveManagement.Models.SMAReportModel>

@{
    ViewData["Title"] = "SMA Dashboard";
}

<div class="dashboard-wrapper">

    <div class="dashboard-header">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; width:100%;">
            <div>
                <h2>SMA Permits</h2>
                <p>View and track SMA valve chamber permit requests.</p>
            </div>
           
        </div>
    </div>

    <form asp-controller="Permit" asp-action="SMA" method="get" class="filter-card">
        <div class="filter-title">Filters</div>

        <div class="filter-row">
            <select name="status">
                <option value="">All Status</option>
                <option value="Requested" selected="@(Context.Request.Query["status"] == "Requested" ? "selected" : null)">Requested</option>
                <option value="Approved" selected="@(Context.Request.Query["status"] == "APPROVED" ? "selected" : null)">Approved</option>
                <option value="Rejected"
                        selected="@(Context.Request.Query["status"] == "REJECTED" ? "selected" : null)">
                    Rejected
                </option>
                <option value="Closed" selected="@(Context.Request.Query["status"] == "Closed" ? "selected" : null)">Closed</option>
            </select>

            <input type="date"
                   name="fromDate"
                   placeholder="Start Date"
                   value="@Context.Request.Query["fromDate"]" />

            <input type="date"
                   name="toDate"
                   placeholder="Search Permit Number"
                   value="@Context.Request.Query["toDate"]" />
            <input type="text"
                   name="permitNumber"
                   placeholder="Search Permit Number"
                   value="@Context.Request.Query["permitNumber"]" />

            <button type="submit" class="apply-btn">
                Apply
            </button>

            <a asp-controller="Permit"
               asp-action="SMA"
               class="clear-btn">
                Clear Filter
            </a>
        </div>
    </form>

    <div class="record-count">
        Total Records: <strong>@Model.Count</strong> | Showing: <strong>100</strong>
    </div>

    <div class="table-card">
        @if (ViewBag.NoData != null)
        {
            <div class="alert alert-warning" style="margin-bottom:15px;">
                @ViewBag.NoData
            </div>
        }
        <table class="report-table">
            <thead>
                <tr>
                    <th>Permit No</th>
                    <th>Gascoseeker</th>
                    <th>Hira Document</th>
                    <th>TBT Document</th>
                    <th>STC</th>
                    <th>Technician</th>
                    <th>ERP</th>
                    <th>Other Image</th>
                    <th>Closure Photo 1</th>
                    <th>Closure Photo 2</th>
                    <th>Closure Photo 3</th>
                    <th>Valve Name</th>
                    <th>District</th>
                    <th>Valve Id</th>
                    <th>AIC Name</th>
                    <th>TPE Name</th>
                    <th>STC No</th>
                    <th>Created On</th>
                    <th>Status</th>
                    <th>Emp Id</th>
                    <th>Review Message</th>
                    <th>Approved On</th>
                    <th>Closed On</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.Take(100))
                {
                    <tr>
                        <td>@item.PermitNo</td>
                        <td>
                            <img src="~/images/permits/gascoseeker.png"
                                 width="80"
                                 height="60"
                                 style="border-radius:8px; cursor:pointer;"
                                 onclick="openImageModal('/images/permits/gascoseeker.png')" />
                        </td>
                        <td>
                            <img src="~/images/permits/hira1.png"
                                 width="80" height="60"
                                 style="border-radius:8px; cursor:pointer;"
                                 onclick="openImageModal('/images/permits/hira1.png')" />
                        </td>
                        <td>
                            <img src="~/images/permits/tbt1.png"
                                 width="80" height="60"
                                 style="border-radius:8px; cursor:pointer;"
                                 onclick="openImageModal('/images/permits/tbt1.png')" />
                        </td>
                        <td>
                            <img src="~/images/permits/stc1.png"
                                 width="80" height="60"
                                 style="border-radius:8px; cursor:pointer;"
                                 onclick="openImageModal('/images/permits/stc1.png')" />
                        </td>
                        <td>
                            <img src="~/images/permits/firstaidbox.png"
                                 width="80" height="60"
                                 style="border-radius:8px; cursor:pointer;"
                                 onclick="openImageModal('/images/permits/firstaidbox.png')" />
                        </td>
                        <td>
                            <img src="~/images/permits/hira2.png"
                                 width="80" height="60"
                                 style="border-radius:8px; cursor:pointer;"
                                 onclick="openImageModal('/images/permits/hira2.png')" />
                        </td>
                        <td>
                            <img src="~/images/permits/erp.png"
                                 width="80" height="60"
                                 style="border-radius:8px; cursor:pointer;"
                                 onclick="openImageModal('/images/permits/erp.png')" />
                        </td>
                        <td>
                            <img src="~/images/permits/barricading1.png"
                                 width="80" height="60"
                                 style="border-radius:8px; cursor:pointer;"
                                 onclick="openImageModal('/images/permits/barricading1.png')" />
                        </td>
                        <td>
                            <img src="~/images/permits/barricading2.png"
                                 width="80" height="60"
                                 style="border-radius:8px; cursor:pointer;"
                                 onclick="openImageModal('/images/permits/barricading2.png')" />
                        </td>
                        <td>
                            <img src="~/images/permits/erp.png"
                                 width="80" height="60"
                                 style="border-radius:8px; cursor:pointer;"
                                 onclick="openImageModal('/images/permits/erp.png')" />
                        </td>
                        <td>@item.ValveName</td>
                        <td>@item.District</td>
                        <td>@item.ValveId</td>
                        <td>@item.AICName</td>
                        <td>@(string.IsNullOrEmpty(item.TPEName) ? "-" : item.TPEName)</td>
                        <td>@item.STCNo</td>
                        <td>
                            @(string.IsNullOrWhiteSpace(item.CreatedOn)
                                                    ? "-"
                                                    : Convert.ToDateTime(item.CreatedOn).ToString("dd-MM-yyyy"))
                        </td>
                        <td>
                            @(string.IsNullOrEmpty(item.Status) ? "-" : item.Status)
                        </td>
                        <td>@item.EmpId</td>
                        <td>
                            @(string.IsNullOrWhiteSpace(item.ReviewMessage)
                                                    ? "-"
                                                    : item.ReviewMessage)
                        </td>
                        <td>
                            @(string.IsNullOrWhiteSpace(item.ApprovedOn)
                                                    ? "-"
                                                    : Convert.ToDateTime(item.ApprovedOn).ToString("dd-MM-yyyy"))
                        </td>
                        <td>
                            @(string.IsNullOrWhiteSpace(item.ClosedOn)
                                                    ? "-"
                                                    : Convert.ToDateTime(item.ClosedOn).ToString("dd-MM-yyyy"))
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Count > 10)
    {
        <div class="pagination-container">
            <div class="pagination-buttons">
                <button id="prevBtn" class="page-btn">← Previous</button>
                <button id="nextBtn" class="page-btn">Next →</button>
            </div>

            <div id="pageInfo"></div>
        </div>
    }

</div>
