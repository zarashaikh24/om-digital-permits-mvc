@model CleanValveManagement.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="login-container">

    <div class="left-panel">
        <div class="brand-glow"></div>

        <img src="~/images/mgl-logo.png" class="mgl-logo" alt="MGL Logo" />

        <div class="divider">
            <span></span>
            <div class="dot"></div>
            <span></span>
        </div>

        <h1>O&amp;M Digital Permits</h1>

        <p>
            Secure permit approvals, tracking and compliance for
            Operations &amp; Maintenance activities across MGL assets.
        </p>

        <div class="brand-features">
            <span>Role Based Access</span>
            <span>Audit Logs</span>
            <span>Secure Workflow</span>
        </div>

        <div class="footer-text">
            © 2026 Mahanagar Gas Limited | Version 1.0.0
        </div>
    </div>

    <div class="right-panel">
        <div class="login-card">

            
            <h2>Welcome Back</h2>

            <p class="subtitle">
                Sign in to access the O&amp;M Digital Permits Portal
            </p>

            <form asp-action="Login" asp-controller="Account" method="post">

                <div asp-validation-summary="All" class="validation-box"></div>

                <label>Employee ID</label>
                <div class="input-box">
                    <input asp-for="EmployeeId" placeholder="Enter Employee ID" />
                </div>

                <label>Password</label>
                <div class="input-box">
                    <input asp-for="Password" id="passwordInput" placeholder="Enter Password" />
                    <button type="button" class="eye-btn" onclick="togglePassword()">
                        <i class="fa fa-eye"></i>
                    </button>
                </div>

                <div class="options">
                    <label class="remember">
                        <input asp-for="RememberMe" />
                        Remember Me
                    </label>

                    <a href="/Account/ForgotPassword">Forgot Password?</a>
                </div>
                

                <button type="submit" class="login-btn">
                    Sign In
                </button>

                <div class="security-note">
                    Protected by secure authentication and audit monitoring.
                </div>

                

            </form>

        </div>
    </div>

</div>

<script>
    function togglePassword() {
        const password = document.getElementById("passwordInput");
        password.type = password.type === "password" ? "text" : "password";
    }
</script>